PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/timmytails
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173

TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_LOG_ONLY=true

GOOGLE_CLIENT_ID=

# Google Cloud Vertex AI / Gemini image generation (Nano Banana)
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=global

# Local development: run `gcloud auth application-default login` and
# normally leave GOOGLE_APPLICATION_CREDENTIALS empty.
GOOGLE_APPLICATION_CREDENTIALS=

# Production alternatives supported by routes/ai.js.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_CLOUD_ACCESS_TOKEN=

# Source verification uses a short low-latency attempt, then a stable fallback.
# These are separate from the image-generation model and replace the older
# GEMINI_VISION_MODEL setting for AI preview verification.
GEMINI_SOURCE_VERIFICATION_MODEL=gemini-2.5-flash-lite
GEMINI_SOURCE_VERIFICATION_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_FIDELITY_MODEL=gemini-2.5-flash

# Nano Banana image editing model.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K
GEMINI_IMAGE_ASPECT_RATIO=1:1
AI_IMAGE_TIMEOUT_MS=240000
AI_PHOTO_VERIFICATION_TIMEOUT_MS=30000
AI_SOURCE_VERIFICATION_MODEL_TIMEOUT_MS=12000
AI_PROVIDER_MAX_RETRIES=1
AI_PROVIDER_RETRY_DELAY_MS=4000

# Increment this when prompts, safety checks, or image models change so stale
# browser previews are not reused against a newer preview pipeline.
AI_PREVIEW_VERSION=2026-08-pet-fidelity-v5-fast-species-guard
AI_PREVIEW_RETENTION_DAYS=7
AI_FIDELITY_CHECK_ENABLED=true
AI_FIDELITY_MAX_GENERATION_ATTEMPTS=1

MAX_BOOKING_DAYS=90
BOOKING_LEAD_MINUTES=30
BOOKING_CLOSED_DAYS=0

# SMTP / Nodemailer Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TimmyTails Pet Grooming" <timmytails.cs@gmail.com>

